	$(COPY_FILE) --parents ../../carwindow.ui ../../companionwindow.ui ../../drivercompanionwindow.ui ../../driverwindow.ui ../../feetback.ui ../../finishwindow.ui ../../loginwindow.ui ../../mainwindow.ui ../../registrationwindow.ui $(DISTDIR)/


